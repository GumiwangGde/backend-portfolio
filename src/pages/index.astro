---
import MainLayout from "../layouts/MainLayout.astro";
import ThreeDolphin from "../components/ThreeDolphin.astro";
import { profile } from "../data/profile";
---

<MainLayout title={`${profile.name} — ${profile.titles[0]}`} hideFooter={true}>
  <div class="h-full min-h-[calc(100vh-5rem)] flex flex-col justify-center items-center">
    
    <div class="w-full grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-16 xl:gap-24 items-center my-auto">
      
      <!-- Left Column: Minimalist Typography, Black Download CV Button & Neutral Social Icons -->
      <div class="md:col-span-6 lg:col-span-6 xl:col-span-5 flex flex-col justify-center items-start text-left space-y-4 sm:space-y-5 z-10 py-4 md:py-0">
        
        <!-- Main Headline (Minimalist) -->
        <div class="space-y-1 sm:space-y-1.5">
          <h1 class="reveal-1 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#1d1d1f] leading-tight">
            Hi, I'm <span class="apple-headline">{profile.name}</span>
          </h1>
          
          <p class="reveal-2 text-lg sm:text-xl font-semibold text-[#1d1d1f] tracking-tight">
            {profile.titles[0]}
          </p>
        </div>

        <!-- Description Paragraph -->
        <p class="reveal-3 text-sm sm:text-base text-[#6e6e73] font-normal max-w-lg leading-relaxed">
          {profile.summary}
        </p>

        <!-- Action Button: Minimalist Black Download CV Button -->
        <div class="reveal-4 pt-2">
          <a
            href="/cv.pdf"
            download="CV_Gumiwang_Gde_Derazatna.pdf"
            target="_blank"
            class="px-6 py-2.5 sm:px-7 sm:py-3 rounded-full bg-[#1d1d1f] hover:bg-black text-white text-xs sm:text-sm font-medium inline-flex items-center gap-2 shadow-sm hover:shadow active:scale-95 transition-all cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download CV</span>
          </a>
        </div>

        <!-- Minimalist Neutral Social Icons -->
        <div class="reveal-5 flex items-center gap-2.5 pt-3 sm:pt-4 text-[#6e6e73]">
          <!-- LinkedIn -->
          <a
            href={profile.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/4 hover:bg-black/8 hover:text-[#1d1d1f] text-[#6e6e73] flex items-center justify-center transition-all"
            aria-label="LinkedIn"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25c-.9 0-1.63.73-1.63 1.63s.73 1.63 1.63 1.63 1.63-.73 1.63-1.63c0-.9-.73-1.63-1.63-1.63Z" />
            </svg>
          </a>
          
          <!-- GitHub -->
          <a
            href={profile.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/4 hover:bg-black/8 hover:text-[#1d1d1f] text-[#6e6e73] flex items-center justify-center transition-all"
            aria-label="GitHub"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z" />
            </svg>
          </a>

          <!-- WhatsApp -->
          <a
            href={profile.social.phone}
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/4 hover:bg-black/8 hover:text-[#1d1d1f] text-[#6e6e73] flex items-center justify-center transition-all"
            aria-label="WhatsApp"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.64c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.74-.66-1.24-1.48-1.39-1.73-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1s.9 2.44 1.03 2.61c.13.17 1.77 2.71 4.3 3.8 2.53 1.09 2.53.73 2.99.69.46-.04 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.18-.48-.31Z" />
            </svg>
          </a>

          <!-- Email / Contact -->
          <a
            href="/contact"
            class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/4 hover:bg-black/8 hover:text-[#1d1d1f] text-[#6e6e73] flex items-center justify-center transition-all"
            aria-label="Contact"
          >
            <svg class="w-3.5 h-3.5 fill-none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>

      </div>

      <!-- Right Column: Interactive 3D Dolphin Canvas -->
      <div class="reveal-2 md:col-span-6 lg:col-span-6 xl:col-span-7 flex items-center justify-center h-full w-full">
        <ThreeDolphin />
      </div>

    </div>

  </div>
</MainLayout>
