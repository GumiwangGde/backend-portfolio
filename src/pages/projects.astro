---
import MainLayout from "../layouts/MainLayout.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";
---

<MainLayout 
  title={`Projects — ${profile.name}`}
  description="Featured software projects by Gumiwang Gde Derazatna, including TAPINAJA, PT Merdeka Sejahtera portal, Hydrate mobile app, and RKD WordPress Suite."
  hideFooter={true}
>
  <div class="h-full min-h-[calc(100vh-6rem)] flex flex-col justify-center py-6 sm:py-10">
    
    <div class="w-full space-y-8 sm:space-y-10 my-auto">
      
      <!-- Top Hero Section: Standalone Editorial Layout (Matching About, Home, Experience) -->
      <div class="space-y-4 max-w-4xl text-left">
        
        <!-- Badge with Icon -->
        <div class="reveal-1">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/[0.04] text-xs font-medium text-[#1d1d1f] border border-black/[0.06]">
            <span class="w-4 h-4 rounded-full bg-black/10 flex items-center justify-center text-[10px] font-bold text-[#1d1d1f]">
              PR
            </span>
            <span>Featured Portfolio</span>
          </span>
        </div>

        <!-- Big Clean Headline -->
        <h1 class="reveal-2 text-3xl sm:text-4xl lg:text-5xl font-normal tracking-tight text-[#1d1d1f] leading-[1.18]">
          Selected Work. <span class="apple-headline">Built for production.</span>
        </h1>

        <!-- Copywriting Subtitle -->
        <p class="reveal-3 text-sm sm:text-base text-[#6e6e73] font-normal leading-relaxed max-w-2xl">
          Full-stack platforms, edge-accelerated microservices, sensor-driven mobile apps, and enterprise portals.
        </p>

      </div>

      <!-- Minimalist Projects Grid: 2 Items Per Row with Project Mockup Images -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-7">
        {
          projects.map((project, index) => {
            const revealClass = index === 0 ? "reveal-3" : index === 1 ? "reveal-3" : index === 2 ? "reveal-4" : "reveal-4";

            return (
              <div class={`${revealClass} group p-6 sm:p-7 rounded-3xl bg-white/75 border border-black/[0.06] backdrop-blur-xl shadow-sm hover:shadow-md hover:border-black/10 transition-all flex flex-col justify-between space-y-4 text-left relative`}>
                
                <!-- Project Browser Mockup / Image Container -->
                {project.image && (
                  <div class="relative w-full h-48 sm:h-56 md:h-60 overflow-hidden rounded-2xl bg-black/[0.02] border border-black/[0.06]">
                    <img
                      src={project.image}
                      alt={project.title}
                      class="w-full h-full object-cover object-top transform group-hover:scale-105 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-transparent pointer-events-none"></div>
                  </div>
                )}

                <!-- Card Header -->
                <div class="space-y-2">
                  <div class="flex items-center justify-between gap-3">
                    <h2 class="text-xl sm:text-2xl font-bold text-[#1d1d1f] tracking-tight">
                      {project.title}
                    </h2>

                    <!-- Direct Action Link Button -->
                    {project.url && (
                      <a
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="apple-btn-secondary px-3.5 py-1.5 text-xs font-medium inline-flex items-center gap-1.5 shrink-0"
                      >
                        <span>Live</span>
                        <span class="text-[#0071e3]">↗</span>
                      </a>
                    )}

                    <!-- Multi-Portal Clean Dropdown Popover (for RKD & Multi-site projects) -->
                    {project.links && !project.url && (
                      <div class="relative" data-dropdown-container>
                        <button
                          type="button"
                          data-dropdown-toggle
                          class="apple-btn-secondary px-3.5 py-1.5 text-xs font-medium inline-flex items-center gap-1.5 shrink-0 cursor-pointer select-none"
                          aria-expanded="false"
                        >
                          <span>Live</span>
                          <svg class="w-3 h-3 text-[#0071e3] transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                          </svg>
                        </button>

                        <!-- Clean Frosted Glass Popover Menu -->
                        <div
                          data-dropdown-menu
                          class="hidden absolute right-0 top-full mt-2 w-52 p-1.5 rounded-2xl bg-white/95 backdrop-blur-2xl border border-black/10 shadow-xl shadow-black/10 z-30 transition-all origin-top-right"
                        >
                          <div class="px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-[#86868b] border-b border-black/[0.06] mb-1">
                            Ecosystem Portals
                          </div>
                          {project.links.map((link) => (
                            <a
                              href={link.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-[#1d1d1f] hover:bg-[#0071e3]/10 hover:text-[#0071e3] transition-colors"
                            >
                              <span>{link.label}</span>
                              <span class="text-[10px] text-[#0071e3]">↗</span>
                            </a>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>

                  <p class="text-xs sm:text-sm text-[#6e6e73] font-normal leading-relaxed">
                    {project.subtitle}
                  </p>
                </div>

                <!-- Technical Highlights -->
                <div class="space-y-2 pt-1">
                  <ul class="space-y-2 text-xs sm:text-sm text-[#6e6e73] leading-relaxed">
                    {project.points.slice(0, 3).map((pt) => (
                      <li class="flex items-start gap-2.5">
                        <span class="text-[#0071e3] font-bold mt-0.5">•</span>
                        <span>{pt}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Tech Stack Badge Strip -->
                <div class="pt-4 border-t border-black/[0.06] flex flex-wrap gap-1.5">
                  {project.stack.map((item) => (
                    <span class="px-2.5 py-1 rounded-full text-[11px] font-medium bg-black/[0.03] text-[#1d1d1f] border border-black/[0.05]">
                      {item}
                    </span>
                  ))}
                </div>

              </div>
            );
          })
        }
      </div>

    </div>

  </div>
</MainLayout>

<script>
  function setupProjectDropdowns() {
    const containers = document.querySelectorAll<HTMLElement>("[data-dropdown-container]");
    
    containers.forEach((container) => {
      const btn = container.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
      const menu = container.querySelector<HTMLElement>("[data-dropdown-menu]");
      const chevron = btn?.querySelector<SVGElement>("svg");
      if (!btn || !menu) return;

      btn.onclick = (e) => {
        e.stopPropagation();
        const isOpen = !menu.classList.contains("hidden");
        
        // Close any other open dropdowns first
        document.querySelectorAll("[data-dropdown-menu]").forEach((m) => {
          m.classList.add("hidden");
        });
        document.querySelectorAll("[data-dropdown-toggle] svg").forEach((c) => {
          c.classList.remove("rotate-180");
        });

        if (!isOpen) {
          menu.classList.remove("hidden");
          chevron?.classList.add("rotate-180");
          btn.setAttribute("aria-expanded", "true");
        } else {
          menu.classList.add("hidden");
          chevron?.classList.remove("rotate-180");
          btn.setAttribute("aria-expanded", "false");
        }
      };
    });

    // Close when clicking outside
    document.addEventListener("click", () => {
      document.querySelectorAll("[data-dropdown-menu]").forEach((m) => {
        m.classList.add("hidden");
      });
      document.querySelectorAll("[data-dropdown-toggle] svg").forEach((c) => {
        c.classList.remove("rotate-180");
      });
      document.querySelectorAll("[data-dropdown-toggle]").forEach((b) => {
        b.setAttribute("aria-expanded", "false");
      });
    });

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        document.querySelectorAll("[data-dropdown-menu]").forEach((m) => {
          m.classList.add("hidden");
        });
        document.querySelectorAll("[data-dropdown-toggle] svg").forEach((c) => {
          c.classList.remove("rotate-180");
        });
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupProjectDropdowns);
  } else {
    setupProjectDropdowns();
  }

  document.addEventListener("astro:page-load", setupProjectDropdowns);
</script>
