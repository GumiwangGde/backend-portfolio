---
import MainLayout from "../layouts/MainLayout.astro";
import { profile } from "../data/profile";
import { workExperiences } from "../data/experience";
import { technicalSkills } from "../data/skills";
---

<MainLayout 
  title={`Experience — ${profile.name}`}
  description="Work experience as Full Stack Developer and Backend Developer Intern, and technical skills matrix."
  hideFooter={true}
>
  <div class="h-full min-h-[calc(100vh-6rem)] flex flex-col justify-center py-6 sm:py-10">
    
    <div class="w-full space-y-10 sm:space-y-14 my-auto">
      
      <!-- Top Hero Section: Standalone Editorial Layout (Matching About & Homepage) -->
      <div class="space-y-4 max-w-4xl text-left">
        
        <!-- Badge with Icon -->
        <div class="reveal-1">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/4 text-xs font-medium text-[#1d1d1f] border border-black/6">
            <span>Career & Capabilities</span>
          </span>
        </div>

        <!-- Big Clean Headline -->
        <h1 class="reveal-2 text-3xl sm:text-4xl lg:text-5xl font-normal tracking-tight text-[#1d1d1f] leading-[1.18]">
          Experience. <span class="apple-headline">Built through practice.</span>
        </h1>

        <!-- Copywriting Subtitle -->
        <p class="reveal-3 text-sm sm:text-base text-[#6e6e73] font-normal leading-relaxed max-w-2xl">
          Production applications, hospital backend services, edge-accelerated caching, and containerized automated pipelines.
        </p>

      </div>

      <!-- Zig-Zag Work History Section -->
      <div class="space-y-6 sm:space-y-8">
        
        <!-- Item 1: Freelance (Role on Left, Bullets on Right) -->
        <div class="reveal-3 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-start p-6 sm:p-8 rounded-3xl bg-white/70 border border-black/6 backdrop-blur-xl shadow-sm">
          
          <!-- Left: Meta & Title -->
          <div class="lg:col-span-5 space-y-3.5 text-left">
            <div class="flex items-center gap-2.5">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#0071e3]/10 text-[#0071e3] border border-[#0071e3]/20">
                {workExperiences[0].company}
              </span>
              <span class="text-xs text-[#86868b] font-medium">
                {workExperiences[0].period}
              </span>
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold text-[#1d1d1f] tracking-tight">
              {workExperiences[0].role}
            </h2>

            <!-- Stack Pills -->
            <div class="flex flex-wrap gap-1.5 pt-1">
              {workExperiences[0].stack.map((tech) => (
                <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-black/3 text-[#1d1d1f] border border-black/5">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Right: Deliverables -->
          <div class="lg:col-span-7 border-t lg:border-t-0 lg:border-l border-black/8 pt-4 lg:pt-0 lg:pl-8 text-left">
            <ul class="space-y-2.5 text-xs sm:text-sm text-[#6e6e73] leading-relaxed">
              {workExperiences[0].points.map((pt) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-[#0071e3] mt-0.5 font-bold">•</span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>

        <!-- Item 2: PT Wahana Meditek (Inverted Zig-Zag: Bullets on Left, Role on Right) -->
        <div class="reveal-4 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-start p-6 sm:p-8 rounded-3xl bg-white/70 border border-black/6 backdrop-blur-xl shadow-sm">
          
          <!-- Left: Deliverables (on desktop comes first) -->
          <div class="lg:col-span-7 order-2 lg:order-1 border-t lg:border-t-0 lg:border-r border-black/8 pt-4 lg:pt-0 lg:pr-8 text-left">
            <ul class="space-y-2.5 text-xs sm:text-sm text-[#6e6e73] leading-relaxed">
              {workExperiences[1].points.map((pt) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-[#0071e3] mt-0.5 font-bold">•</span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Right: Meta & Title -->
          <div class="lg:col-span-5 order-1 lg:order-2 space-y-3.5 text-left">
            <div class="flex items-center gap-2.5">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#0071e3]/10 text-[#0071e3] border border-[#0071e3]/20">
                {workExperiences[1].company}
              </span>
              <span class="text-xs text-[#86868b] font-medium">
                {workExperiences[1].period}
              </span>
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold text-[#1d1d1f] tracking-tight">
              {workExperiences[1].role}
            </h2>

            <!-- Stack Pills -->
            <div class="flex flex-wrap gap-1.5 pt-1">
              {workExperiences[1].stack.map((tech) => (
                <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-black/3 text-[#1d1d1f] border border-black/5">
                  {tech}
                </span>
              ))}
            </div>
          </div>

        </div>

      </div>

      <!-- Skills Matrix Section -->
      <div class="pt-6 sm:pt-8 border-t border-black/8 space-y-5">
        <div class="reveal-4 flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-[#86868b]">
            Skills Matrix & Capabilities
          </span>
          <span class="text-xs text-[#86868b]">
            {technicalSkills.reduce((acc, g) => acc + g.items.length, 0)} Technologies
          </span>
        </div>

        <div class="reveal-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5 xl:gap-4">
          {technicalSkills.map((group) => (
            <div class="p-5 rounded-2xl bg-white/60 border border-black/6 backdrop-blur-md space-y-3 text-left">
              <h4 class="text-xs font-bold text-[#1d1d1f] tracking-tight uppercase">
                {group.category}
              </h4>
              <div class="flex flex-wrap gap-1.5">
                {group.items.map((skill) => (
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-black/3 text-[#6e6e73] border border-black/5">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</MainLayout>
