---
const { title } = Astro.props;
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Gumiwang Gde | CTO & Backend Developer</title>
    <meta name="title" content="Gumiwang Gde | CTO & Backend Developer" />
    <meta name="description" content="Backend Engineer & CTO at Neurobyte. Expert in .NET, Node.js, and Distributed Systems architecture."/>
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://portfolio.gugum.my.id/" />
    <meta property="og:title" content="Gumiwang Gde | CTO & Backend Developer"/>
    <meta property="og:description" content="Explore my professional journey in backend development and system architecture."/>
    <meta property="og:image" content="https://portfolio.gugum.my.id/og-image.jpg"/>
    <meta name="google-site-verification" content="qyyi6TaTO3Gp0ZiOp9n0HR4lBkCxHXuVt5zEX8St12o"/>
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />

    <main>
      <slot />
    </main>

    <footer class="p-8 text-center text-gray-500">
      &copy; 2024 - Portfolio Backend Developer
    </footer>
  </body>
</html>
