---
import { profile } from "../data/profile";
---

<section id="about" class="py-32 border-t border-sky-500/[0.12] relative">
  <div class="max-w-7xl mx-auto px-6 sm:px-12">
    
    <!-- Micro Section Header -->
    <div class="font-mono text-xs tracking-widest uppercase text-sky-400 mb-12">
      01 // ABOUT
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
      
      <!-- Left Editorial Column -->
      <div class="lg:col-span-6 space-y-10">
        <h2 class="font-serif-display text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.05] tracking-tight">
          A curious mind. <br />
          <span class="italic-serif text-sky-200">A builder at heart.</span>
        </h2>

        <div class="space-y-6 text-base text-slate-300 font-normal leading-relaxed">
          <p>
            I am a software engineer with a strong focus on backend infrastructure, custom WordPress development, and scalable system design. I enjoy turning complex system requirements into clean, reliable, and maintainable software.
          </p>
          <p>
            With technical leadership experience as former CTO at PT Neurobyte, I combine practical engineering with strategic planning—ensuring that every platform is performant, secure, and built for long-term growth.
          </p>
        </div>

        <!-- Academic Institution Box -->
        <div class="p-6 sm:p-8 border border-sky-500/20 bg-[#081224]/60 backdrop-blur-sm space-y-3 rounded-xl">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs tracking-wider uppercase text-sky-400 font-medium">
              Academic Background
            </span>
            <span class="font-mono text-xs tracking-wider uppercase px-2.5 py-0.5 rounded bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">
              Graduated Aug 2026
            </span>
          </div>
          <h3 class="font-serif-display text-2xl text-white">
            Politeknik Elektronika Negeri Surabaya
          </h3>
          <p class="text-sm text-slate-300 font-normal leading-relaxed">
            Informatics Engineering (Aug 2023 — Aug 2026). Studied core computer science fundamentals, distributed systems, algorithms, operating systems, and network architectures.
          </p>
        </div>
      </div>

      <!-- Right Editorial Column: Focus Areas -->
      <div class="lg:col-span-6 space-y-10 lg:pl-8 lg:border-l lg:border-sky-500/[0.12]">
        
        <div class="font-mono text-xs tracking-widest uppercase text-sky-400">
          CORE FOCUS AREAS
        </div>

        <div class="space-y-8">
          <div class="space-y-2">
            <div class="font-mono text-sm text-white font-medium">
              01 — Backend & API Engineering
            </div>
            <p class="text-sm text-slate-300 leading-relaxed">
              Designing scalable RESTful APIs and asynchronous background services with Node.js, ASP.NET Core, and RabbitMQ.
            </p>
          </div>

          <div class="space-y-2">
            <div class="font-mono text-sm text-white font-medium">
              02 — Custom CMS & Headless Platforms
            </div>
            <p class="text-sm text-slate-300 leading-relaxed">
              Developing custom WordPress themes, LiteSpeed optimization, and headless CMS integrations (Strapi) tailored for organizational ecosystems.
            </p>
          </div>

          <div class="space-y-2">
            <div class="font-mono text-sm text-white font-medium">
              03 — Database & Cloud Reliability
            </div>
            <p class="text-sm text-slate-300 leading-relaxed">
              Managing relational database architectures with PostgreSQL and MySQL, distributed in-memory caching with Redis, and containerized deployment with Docker.
            </p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
