---
import { profile } from "../data/profile";

const navLinks = [
  { name: "About", href: "#about" },
  { name: "Selected Work", href: "#work" },
  { name: "Experience", href: "#experience" },
  { name: "Contact", href: "#contact" },
];
---

<header class="fixed top-0 inset-x-0 z-50 bg-[#050b14]/75 backdrop-blur-md border-b border-sky-500/[0.08] transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 sm:px-12">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brandmark -->
      <a href="#home" class="group flex items-center gap-3">
        <span class="font-mono text-xs font-semibold tracking-[0.25em] text-white uppercase group-hover:text-sky-300 transition-colors">
          GUMIWANG
        </span>
      </a>

      <!-- Desktop Links -->
      <nav class="hidden md:flex items-center gap-8 font-mono text-[11px] tracking-[0.18em] uppercase text-slate-400">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="hover:text-white transition-colors relative py-1"
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <!-- Right Indicator & Contact Trigger -->
      <div class="flex items-center gap-6">
        <a
          href={`mailto:${profile.email}`}
          class="hidden sm:inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.18em] uppercase text-slate-400 hover:text-sky-300 transition-colors"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          <span>AVAILABLE FOR ROLES</span>
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-toggle"
          class="md:hidden text-slate-400 hover:text-white p-2 focus:outline-none"
          aria-label="Toggle Navigation"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 8h16M4 16h16" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Dropdown -->
    <div
      id="mobile-dropdown"
      class="hidden md:hidden py-6 border-t border-sky-500/[0.08] bg-[#050b14]/95 space-y-4 font-mono text-xs tracking-[0.2em] uppercase"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-link block text-slate-400 hover:text-sky-300 py-2"
          >
            {link.name}
          </a>
        ))
      }
      <a
        href={`mailto:${profile.email}`}
        class="mobile-link block text-white pt-2 border-t border-sky-500/[0.08]"
      >
        LET'S CONNECT ↗
      </a>
    </div>

  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-toggle");
  const dropdown = document.getElementById("mobile-dropdown");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  toggle?.addEventListener("click", () => {
    dropdown?.classList.toggle("hidden");
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      dropdown?.classList.add("hidden");
    });
  });
</script>
