---
// ThreeBackground.astro
---

<div 
  id="three-background-container" 
  class="fixed inset-0 pointer-events-none z-0 opacity-70 overflow-hidden"
  aria-hidden="true"
></div>

<script>
  import { ThreeBackgroundScene } from "../scripts/three-background";

  const bgContainer = document.getElementById("three-background-container");
  let bgInstance: ThreeBackgroundScene | null = null;

  if (bgContainer && window.innerWidth > 640) {
    // Initialize background scene for non-tiny screens
    bgInstance = new ThreeBackgroundScene(bgContainer);
  }

  document.addEventListener("astro:before-swap", () => {
    bgInstance?.destroy();
  });
</script>
