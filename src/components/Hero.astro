---

---

<section id="home" class="min-h-screen flex items-center pt-20">
  <div class="max-w-6xl mx-auto px-6 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-8 py-10">
        <div
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-50 text-cyan-600 text-xs font-semibold border border-cyan-100"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"
            ></span>
          </span>
          Available for opportunities
        </div>

        <div class="space-y-4">
          <p class="text-slate-500 text-lg font-medium">
            Hi, I'm Gumiwang Gde Derazatna
          </p>
          <h1
            class="text-5xl md:text-5xl font-bold text-[#111827] leading-[1.1]"
          >
            Software Engineer<br />
          </h1>
        </div>

        <ul class="space-y-3">
          {
            [
              "API Architecture & Design",
              "Microservices & Distributed Systems",
              "System Design & Scalability",
            ].map((item) => (
              <li class="flex items-center gap-3 text-slate-500 font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400" />
                {item}
              </li>
            ))
          }
        </ul>

        <div class="flex flex-wrap gap-4 pt-4">
          <a
            href="#projects"
            class="px-8 py-4 bg-[#111827] text-white rounded-xl font-bold flex items-center gap-2 hover:shadow-lg hover:shadow-slate-200 transition-all active:scale-95"
          >
            View Projects <span>→</span>
          </a>
        </div>
      </div>

      <div
        class="relative w-full max-w-xl justify-self-center lg:justify-self-end"
      >
        <div
          class="absolute -inset-4 bg-linear-to-tr from-cyan-100 to-blue-100 rounded-[3rem] blur-2xl opacity-50"
        >
        </div>

        <div
          class="relative bg-white border border-slate-200 rounded-3xl shadow-2xl overflow-hidden"
        >
          <div
            class="bg-slate-50/80 border-b border-slate-100 px-6 py-4 flex items-center justify-between"
          >
            <div class="flex items-center gap-2">
              <span class="text-cyan-600 font-mono text-sm font-bold"
                >&lt;/&gt;</span
              >
              <span class="text-slate-400 text-xs font-mono">Node.js</span>
            </div>
            <div class="flex gap-2">
              <div class="w-3 h-3 rounded-full bg-slate-200"></div>
              <div class="w-3 h-3 rounded-full bg-slate-200"></div>
              <div class="w-3 h-3 rounded-full bg-slate-200"></div>
            </div>
          </div>

          <div class="p-8 font-mono text-[13px] leading-relaxed min-h-70">
            <pre
              class="text-slate-700"><code id="typing-code" /><span class="animate-pulse border-r-2 border-cyan-500">&nbsp;</span></pre>
          </div>

          <div
            class="px-8 py-5 bg-slate-50/50 border-t border-slate-100 flex gap-6"
          >
            <div
              class="flex items-center gap-2 text-xs font-bold text-slate-400"
            >
              <span
                class="w-5 h-5 rounded bg-cyan-100 flex items-center justify-center text-[10px] text-cyan-600"
                >A</span
              > API
            </div>
            <div
              class="flex items-center gap-2 text-xs font-bold text-slate-400"
            >
              <span
                class="w-5 h-5 rounded bg-blue-100 flex items-center justify-center text-[10px] text-blue-600"
                >D</span
              > DATABASE
            </div>
            <div
              class="flex items-center gap-2 text-xs font-bold text-slate-400"
            >
              <span
                class="w-5 h-5 rounded bg-slate-200 flex items-center justify-center text-[10px] text-slate-600"
                >C</span
              > CODE
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const codeContent = `
  const express = require("express");
  const app = express();
  const PORT = 3000;

  app.get("/api/users", (req, res) => {
    res.json({
      Name: "Gumiwang Gde",
      Role: "Software Engineer"
    });
  });

  app.listen(PORT, () => {});
  `;

  const codeElement = document.getElementById("typing-code");
  let index = 0;

  function type() {
    if (codeElement && index < codeContent.length) {
      codeElement.textContent += codeContent.charAt(index);
      index++;
      setTimeout(type, 50);
    }
  }

  window.addEventListener("DOMContentLoaded", type);
</script>
