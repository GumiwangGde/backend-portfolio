---
import { profile } from "../data/profile";
---

<section id="home" class="min-h-screen flex flex-col justify-between pt-36 pb-16 relative">
  <div class="max-w-7xl mx-auto px-6 sm:px-12 w-full">
    
    <!-- Top Micro Labels -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs tracking-wider uppercase text-slate-300 mb-16 sm:mb-24">
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-sky-400"></span>
        <span class="font-medium text-slate-200">{profile.titles[0]}</span>
      </div>
      <div class="text-slate-400">
        <span>{profile.location}</span>
      </div>
    </div>

    <!-- Massive Display Editorial Headline -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
      <div class="lg:col-span-8">
        <h1 class="font-serif-display text-6xl sm:text-7xl md:text-8xl lg:text-[6.5rem] leading-[0.92] text-white tracking-tight">
          The art of <br />
          building <br />
          <span class="italic-serif text-sky-200">core systems.</span>
        </h1>
      </div>

      <!-- Right Side Narrative Excerpt -->
      <div class="lg:col-span-4 space-y-6 lg:pb-3">
        <p class="text-base text-slate-300 font-normal leading-relaxed">
          {profile.bio}
        </p>

        <div class="pt-2">
          <a
            href="#work"
            class="inline-flex items-center gap-3 font-mono text-xs tracking-widest uppercase text-white hover:text-sky-300 transition-colors group"
          >
            <span>EXPLORE WORK</span>
            <span class="group-hover:translate-x-1 group-hover:translate-y-1 transition-transform text-sky-400">↘</span>
          </a>
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom Clear Metadata Bar (Human, Authentic, Clean) -->
  <div class="max-w-7xl mx-auto px-6 sm:px-12 w-full pt-20">
    <div class="border-t border-sky-500/[0.15] pt-8 grid grid-cols-2 md:grid-cols-4 gap-6 font-mono text-xs">
      <div>
        <div class="text-[11px] text-slate-400 uppercase tracking-wider">Location</div>
        <div class="text-slate-200 font-medium mt-1">Surabaya, Indonesia</div>
      </div>
      <div>
        <div class="text-[11px] text-slate-400 uppercase tracking-wider">Specialization</div>
        <div class="text-slate-200 font-medium mt-1">Backend & CMS Engineering</div>
      </div>
      <div>
        <div class="text-[11px] text-slate-400 uppercase tracking-wider">Education</div>
        <div class="text-slate-200 font-medium mt-1">PENS (Graduated Aug 2026)</div>
      </div>
      <div>
        <div class="text-[11px] text-slate-400 uppercase tracking-wider">Status</div>
        <div class="text-sky-300 font-medium mt-1 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Open for Opportunities</span>
        </div>
      </div>
    </div>
  </div>
</section>
