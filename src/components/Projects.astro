---
const projects = [
  {
    title: "Hydration & Activity Tracking",
    badge: "Featured",
    description:
      "Mobile health app to monitor steps and calculate hydration targets using real-time weather data.",
    tech: ["Flutter", "GetX", "Mapbox", "Weather API"],
    role: "Mobile Developer",
    points: [
      "Integrated device sensors for physical activity monitoring.",
      "Implemented Mapbox for real-time route visualization.",
      "Built dynamic hydration logic based on environmental data.",
    ],
    playstore:
      "https://play.google.com/store/apps/details?id=com.hydrate.pdbl&pcampaignid=web_share",
    github: null,
  },
  {
    title: "BidMaster Real-Time Auction",
    badge: "Featured",
    description:
      "Distributed real-time bidding system designed to handle high-concurrency auctions.",
    tech: [".NET Worker", "RabbitMQ", "Express.js", "PostgreSQL"],
    role: "Backend Engineer",
    points: [
      "Built a real-time engine for simultaneous bid handling.",
      "Implemented RabbitMQ for reliable asynchronous processing.",
      "Conducted stress testing with k6 for mass concurrent bidding.",
    ],
    github: "https://github.com/GumiwangGde/bidmaster-api",
    playstore: null,
  },
  {
    title: "Hospital Payment & Inventory",
    badge: "Private",
    description:
      "Backend system for hospital billing and medical inventory with strong data integrity.",
    tech: ["Node.js", "Express.js", "PostgreSQL", "Zod"],
    role: "Backend Engineer",
    points: [
      "Developed secure backend services for hospital transactions.",
      "Built inventory modules to track medical supplies.",
      "Integrated Zod schema for strict API data validation.",
    ],
    github: null,
    playstore: null,
  },
];
---

<section id="projects" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-16">
      <h2 class="text-3xl font-bold text-[#111827] relative inline-block">
        Featured Projects
        <span
          class="absolute -bottom-2 left-0 w-full h-1 bg-cyan-400 rounded-full"
        ></span>
      </h2>
      <p class="mt-4 text-slate-500">
        Showcasing backend architecture and system design expertise
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      {
        projects.map((project) => (
          <div class="group relative bg-white border border-slate-100 rounded-3xl p-8 shadow-sm transition-all duration-300 hover:shadow-2xl hover:shadow-cyan-100/50 hover:-translate-y-3 flex flex-col">
            <div
              class={`absolute -top-3 right-8 px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider shadow-sm z-10 
            ${project.badge === "Featured" ? "bg-cyan-500 text-white" : "bg-slate-100 text-slate-500 border border-slate-200"}`}
            >
              {project.badge}
            </div>

            <div class="grow">
              <h3 class="text-xl font-bold text-[#111827] mb-3 group-hover:text-cyan-600 transition-colors">
                {project.title}
              </h3>
              <p class="text-[13px] text-slate-500 leading-relaxed mb-6">
                {project.description}
              </p>

              <div class="mb-6">
                <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3">
                  Tech Stack
                </h4>
                <div class="flex flex-wrap gap-1.5">
                  {project.tech.map((t) => (
                    <span class="px-3 py-1 bg-cyan-50/50 text-cyan-600 text-[11px] font-medium rounded-lg border border-cyan-100/50">
                      {t}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mb-8">
                <h4 class="text-[11px] font-bold text-slate-700 uppercase mb-3">
                  Role: {project.role}
                </h4>
                <ul class="space-y-2.5">
                  {project.points.map((point) => (
                    <li class="flex gap-2.5 text-[13px] text-slate-500 leading-snug">
                      <span class="text-cyan-500 font-bold">•</span>
                      {point}
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-auto pt-6">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  class="w-full bg-[#111827] text-white py-3 rounded-xl text-sm font-bold flex items-center justify-center gap-2 hover:bg-slate-800 transition-all active:scale-95 shadow-lg shadow-slate-200"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                  GitHub
                </a>
              )}

              {project.playstore && (
                <a
                  href={project.playstore}
                  target="_blank"
                  class="w-full bg-[#111827] text-white py-3 rounded-xl text-sm font-bold flex items-center justify-center gap-2 hover:bg-slate-800 transition-all active:scale-95 shadow-lg shadow-slate-200"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <circle cx="12" cy="12" r="1" />
                    <path d="M12 17v-4" />
                    <path d="M12 7h.01" />
                  </svg>
                  Play Store
                </a>
              )}

              {!project.github && !project.playstore && (
                <div class="w-full bg-slate-50 text-slate-400 py-3 rounded-xl text-sm font-bold flex items-center justify-center gap-2 border border-slate-100 cursor-not-allowed">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                  Private Project
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
