---
import { projects } from "../data/projects";
---

<section id="work" class="py-32 border-t border-sky-500/[0.12] relative">
  <div class="max-w-7xl mx-auto px-6 sm:px-12">
    
    <!-- Micro Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-16">
      <div>
        <div class="font-mono text-xs tracking-widest uppercase text-sky-400 mb-4">
          02 // SELECTED WORK
        </div>
        <h2 class="font-serif-display text-5xl sm:text-6xl lg:text-7xl text-white tracking-tight">
          Selected <span class="italic-serif text-sky-200">work.</span>
        </h2>
      </div>

      <p class="text-sm text-slate-300 max-w-sm leading-relaxed">
        Featured backend architectures, custom WordPress suites, and engineering projects.
      </p>
    </div>

    <!-- Minimalist Editorial List -->
    <div class="border-t border-sky-500/[0.12]">
      {
        projects.map((project, index) => {
          const num = String(index + 1).padStart(2, "0");
          const targetLink = project.liveSites ? project.liveSites[0].url : project.demoUrl || project.github || project.playstore || null;

          return (
            <div class="project-row border-b border-sky-500/[0.1] group transition-colors duration-300 hover:bg-sky-500/[0.03]">
              <div class="py-8 sm:py-10 grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                
                <!-- Index & Title -->
                <div class="md:col-span-6 flex items-start gap-4 sm:gap-6">
                  <span class="font-mono text-xs text-sky-400 font-medium pt-1.5 shrink-0">
                    • {num}
                  </span>
                  <div>
                    <h3 class="font-serif-display text-2xl sm:text-3xl lg:text-4xl text-white group-hover:text-sky-200 transition-colors">
                      {project.title}
                    </h3>
                    <p class="text-sm text-slate-300 mt-1 font-normal line-clamp-1">
                      {project.subtitle}
                    </p>
                  </div>
                </div>

                <!-- Tech Stack Tags -->
                <div class="md:col-span-4 font-mono text-xs text-slate-300">
                  <div class="flex flex-wrap gap-2">
                    {project.tech.slice(0, 3).map((t) => (
                      <span class="text-slate-300 group-hover:text-white transition-colors bg-sky-950/40 px-2.5 py-1 rounded border border-sky-500/20">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Year / Link -->
                <div class="md:col-span-2 flex items-center justify-between md:justify-end gap-4 font-mono text-xs text-slate-400">
                  <span class="text-slate-300 font-medium">
                    {project.year}
                  </span>
                  
                  {targetLink ? (
                    <a
                      href={targetLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sky-400 group-hover:text-white group-hover:translate-x-1 group-hover:-translate-y-1 transition-all text-base p-1"
                      title="View Live Link"
                    >
                      ↗
                    </a>
                  ) : (
                    <span class="text-slate-400 text-xs">INTERNAL</span>
                  )}
                </div>

              </div>

              <!-- Project Details -->
              <div class="pb-8 pt-2 pl-8 sm:pl-12 grid grid-cols-1 md:grid-cols-12 gap-6 border-t border-sky-500/[0.05]">
                <div class="md:col-span-7 space-y-3">
                  <p class="text-sm text-slate-200 leading-relaxed font-normal">
                    {project.description}
                  </p>
                  <div class="font-mono text-xs text-slate-400 flex items-center gap-2">
                    <span class="text-sky-400">Role:</span>
                    <span class="text-slate-200">{project.role}</span>
                  </div>
                </div>

                <div class="md:col-span-5 space-y-3 font-mono text-xs">
                  <!-- Live Sites Links for WordPress Ecosystem -->
                  {project.liveSites ? (
                    <div class="space-y-2">
                      <div class="text-[11px] tracking-wider uppercase text-sky-400 font-medium">
                        Live Portals
                      </div>
                      <div class="space-y-2">
                        {project.liveSites.map((site) => (
                          <a
                            href={site.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center justify-between p-3 rounded-lg border border-sky-500/20 bg-[#09152a]/70 hover:bg-sky-500/15 hover:border-sky-400/40 text-white transition-all group/link"
                          >
                            <div>
                              <div class="font-medium text-white group-hover/link:text-sky-200 text-xs">
                                {site.name}
                              </div>
                              <div class="text-[11px] text-slate-400 mt-0.5">
                                {site.desc}
                              </div>
                            </div>
                            <span class="text-sky-400 group-hover/link:text-white group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 transition-transform text-sm">
                              ↗
                            </span>
                          </a>
                        ))}
                      </div>
                    </div>
                  ) : targetLink && (
                    <div class="pt-2">
                      <a
                        href={targetLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 text-sky-300 hover:text-white border border-sky-500/30 transition-all uppercase tracking-wider text-xs font-medium"
                      >
                        <span>
                          {project.github ? "Source Repository" : "Play Store Listing"}
                        </span>
                        <span>↗</span>
                      </a>
                    </div>
                  )}
                </div>
              </div>

            </div>
          );
        })
      }
    </div>

  </div>
</section>
