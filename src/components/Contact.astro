---
import { profile } from "../data/profile";
---

<section id="contact" class="py-32 border-t border-sky-500/[0.1] relative">
  <div class="max-w-7xl mx-auto px-6 sm:px-12">
    
    <!-- Micro Header -->
    <div class="font-mono text-[11px] tracking-[0.25em] uppercase text-sky-400 mb-12">
      04 // TRANSMISSION & CONTACT
    </div>

    <!-- Massive Display Editorial Headline -->
    <div class="max-w-4xl mb-20">
      <h2 class="font-serif-display text-5xl sm:text-7xl lg:text-8xl text-white leading-[0.95] tracking-tight">
        Let's make <br />
        <span class="italic-serif text-sky-200">something matter.</span>
      </h2>
      <p class="text-sm sm:text-base text-slate-300 font-light mt-8 max-w-xl leading-relaxed">
        Currently open for Chief Technology Officer (CTO) engagements, distributed backend consulting, and high-impact engineering leadership.
      </p>
    </div>

    <!-- Action & Channels Grid -->
    <div class="border-t border-sky-500/[0.1] pt-12 grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
      
      <!-- Direct Email Action Block -->
      <div class="md:col-span-6 space-y-4">
        <div class="font-mono text-[11px] tracking-[0.2em] uppercase text-sky-400">
          DIRECT INQUIRY
        </div>
        
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
          <a
            href={`mailto:${profile.email}`}
            class="font-serif-display text-2xl sm:text-3xl text-white hover:text-sky-300 transition-colors underline decoration-sky-400/30 underline-offset-8"
          >
            {profile.email}
          </a>

          <button
            id="copy-email-btn"
            class="self-start font-mono text-[11px] tracking-[0.15em] uppercase px-3 py-1.5 border border-sky-500/[0.2] text-sky-300 hover:text-white hover:border-sky-400/60 bg-[#09152b]/60 transition-all cursor-pointer"
          >
            <span id="copy-email-label">COPY</span>
          </button>
        </div>

        <p class="font-mono text-xs text-slate-400 pt-2">
          Based in {profile.location} • Responds within 24 hours
        </p>
      </div>

      <!-- Developer Networks & Socials -->
      <div class="md:col-span-6 space-y-4 md:pl-8 md:border-l md:border-sky-500/[0.1]">
        <div class="font-mono text-[11px] tracking-[0.2em] uppercase text-sky-400">
          NETWORKS & PROFILES
        </div>

        <div class="flex flex-wrap gap-8 font-mono text-xs tracking-[0.2em] uppercase">
          <a
            href={profile.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-300 hover:text-sky-300 transition-colors flex items-center gap-1.5 group"
          >
            <span>GITHUB</span>
            <span class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform text-sky-400">↗</span>
          </a>

          <a
            href={profile.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-300 hover:text-sky-300 transition-colors flex items-center gap-1.5 group"
          >
            <span>LINKEDIN</span>
            <span class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform text-sky-400">↗</span>
          </a>

          <a
            href={`mailto:${profile.email}`}
            class="text-slate-300 hover:text-sky-300 transition-colors flex items-center gap-1.5 group"
          >
            <span>EMAIL</span>
            <span class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform text-sky-400">↗</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const copyBtn = document.getElementById("copy-email-btn");
  const copyLabel = document.getElementById("copy-email-label");

  copyBtn?.addEventListener("click", () => {
    navigator.clipboard.writeText("gugumgde26@gmail.com");
    if (copyLabel) copyLabel.textContent = "COPIED ✓";
    setTimeout(() => {
      if (copyLabel) copyLabel.textContent = "COPY";
    }, 2000);
  });
</script>
