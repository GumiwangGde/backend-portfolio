---
import { experiences } from "../data/experience";
import { skillCategories } from "../data/skills";
---

<section id="experience" class="py-32 border-t border-sky-500/[0.12] relative">
  <div class="max-w-7xl mx-auto px-6 sm:px-12">
    
    <!-- Micro Header -->
    <div class="font-mono text-xs tracking-widest uppercase text-sky-400 mb-12">
      03 // EXPERIENCE & SKILLS
    </div>

    <!-- Main Heading -->
    <div class="mb-20">
      <h2 class="font-serif-display text-5xl sm:text-6xl lg:text-7xl text-white tracking-tight">
        Built through <br />
        <span class="italic-serif text-sky-200">experience.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
      
      <!-- Left Column: Career Timeline -->
      <div class="lg:col-span-7 space-y-16">
        {
          experiences.map((exp) => (
            <div class="border-l border-sky-500/[0.25] pl-6 sm:pl-8 relative space-y-4 group">
              <!-- Timeline Marker -->
              <div class="absolute -left-[5px] top-2 w-2.5 h-2.5 rounded-full bg-sky-400 group-hover:bg-white transition-colors shadow-sm shadow-sky-400/50"></div>

              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                <div>
                  <h3 class="font-serif-display text-2xl sm:text-3xl text-white">
                    {exp.company}
                  </h3>
                  <div class="font-mono text-xs text-sky-300 font-medium mt-1">
                    {exp.role}
                  </div>
                </div>

                <div class="font-mono text-xs text-slate-400 tracking-wider">
                  {exp.period}
                </div>
              </div>

              {exp.description && (
                <p class="text-sm text-slate-300 leading-relaxed font-normal">
                  {exp.description}
                </p>
              )}

              <!-- Impact Points -->
              <ul class="space-y-2 pt-2 text-sm text-slate-300 font-normal leading-relaxed">
                {exp.points.map((pt) => (
                  <li class="flex items-start gap-3">
                    <span class="text-sky-400 mt-1.5 text-xs">•</span>
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>

              <!-- Tech Tags -->
              {exp.techStack && (
                <div class="flex flex-wrap gap-2 pt-2">
                  {exp.techStack.map((tech) => (
                    <span class="font-mono text-xs tracking-wider uppercase px-2.5 py-1 border border-sky-500/20 text-slate-300 bg-[#081326]/80 rounded">
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>

      <!-- Right Column: "The tools behind the craft" Accordion -->
      <div class="lg:col-span-5 space-y-8 lg:pl-6">
        
        <div class="font-mono text-xs tracking-widest uppercase text-sky-400 pb-4 border-b border-sky-500/[0.15]">
          THE TOOLS BEHIND THE CRAFT
        </div>

        <div class="space-y-6">
          {
            skillCategories.map((category) => (
              <div class="border-b border-sky-500/[0.1] pb-6 space-y-3">
                <div class="flex items-center justify-between">
                  <h4 class="font-serif-display text-xl sm:text-2xl text-white">
                    {category.title}
                  </h4>
                  <span class="font-mono text-xs text-sky-400 font-medium">
                    {category.skills.length}
                  </span>
                </div>

                <div class="flex flex-wrap gap-x-3 gap-y-2 font-mono text-xs text-slate-300">
                  {category.skills.map((skill, idx) => (
                    <span>
                      <strong class="text-slate-200 font-normal">{skill.name}</strong>
                      {idx < category.skills.length - 1 && <span class="text-slate-400 ml-3">/</span>}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

      </div>

    </div>
  </div>
</section>
