---
const experiences = [
  {
    company: "PT Wahana Meditek Indonesia",
    role: "Backend Developer",
    period: "June 2024 - Dec 2024",
    type: "work",
    points: [
      "Developed and optimized backend services for hospital management systems.",
      "Implemented secure payment processing and inventory tracking modules.",
      "Collaborated with cross-functional teams to deliver robust API solutions.",
    ],
  },
  {
    company: "Politeknik Elektronika Negeri Surabaya",
    role: "Informatics Engineering Student",
    period: "2023 - Present",
    type: "education",
    points: [
      "Focusing on Computer Science fundamentals, Algorithms, and System Design.",
      "Maintaining a strong academic record while actively building production-grade projects.",
      "Participating in technical workshops and laboratory research for backend technologies.",
    ],
  },
  {
    company: "PT Neurobyte",
    role: "Chief Technology Officer (CTO)",
    period: "Dec 2024 - Present",
    type: "work",
    points: [
      "Leading technical strategy and overseeing the development of core technology platforms.",
      "Architecting scalable backend infrastructures to support company growth.",
      "Managing development teams and ensuring best practices in software engineering.",
    ],
  },
];
---

<section id="experience" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-16">
      <h2 class="text-3xl font-bold text-[#111827] relative inline-block">
        Experience
        <span
          class="absolute -bottom-2 left-0 w-full h-1 bg-cyan-400 rounded-full"
        ></span>
      </h2>
      <p class="mt-4 text-slate-500">
        Professional journey in software development and leadership
      </p>
    </div>

    <div class="relative space-y-0">
      {
        experiences.map((exp, index) => (
          <div class="relative pl-12 sm:pl-20 group pb-12 last:pb-0">
            <div
              class={`absolute left-6 lg:left-8 top-0 bottom-0 w-0.5 transition-colors duration-500
        ${index === 0 ? "top-4" : ""} 
        ${index === experiences.length - 1 ? "bottom-auto h-12" : ""}
        bg-slate-100 group-hover:bg-cyan-500`}
            ></div>

            <div class="absolute left-3.5 lg:left-5 top-1 w-6 h-6 sm:w-8 sm:h-8 bg-white border-2 border-slate-100 rounded-lg flex items-center justify-center z-10 group-hover:border-cyan-500 group-hover:bg-cyan-500 transition-all duration-500">
              {exp.type === "work" ? (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-3 h-3 sm:w-4 sm:h-4 text-slate-400 group-hover:text-white"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                </svg>
              ) : (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-3 h-3 sm:w-4 sm:h-4 text-slate-400 group-hover:text-white"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                  <path d="M6 12v5c3 3 9 3 12 0v-5" />
                </svg>
              )}
            </div>

            <div class="bg-white border border-slate-100 rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-xl hover:shadow-cyan-100/30 transition-all duration-500">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                <div>
                  <h3 class="text-xl font-bold text-[#111827] group-hover:text-cyan-600 transition-colors">
                    {exp.company}
                  </h3>
                  <p class="text-slate-500 group-hover:text-cyan-500 font-bold text-sm mt-1 transition-colors">
                    {exp.role}
                  </p>
                </div>
                <div class="flex items-center gap-2 text-slate-400 text-sm font-medium bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-100 self-start sm:self-center">
                  {exp.period}
                </div>
              </div>

              <ul class="space-y-4">
                {exp.points.map((point) => (
                  <li class="flex items-start gap-3 text-slate-500 text-sm leading-relaxed">
                    <span class="text-slate-300 group-hover:text-cyan-500 mt-1 font-bold transition-colors">
                      →
                    </span>
                    {point}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
